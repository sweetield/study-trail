{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "study-trail",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // 每天 UTC 19:00（北京时间 03:00）清理过期会话、旧通知与审计日志
  "triggers": { "crons": ["0 19 * * *"] },
  // 不写 database_id：首次部署时 Cloudflare 自动创建 D1 数据库，之后沿用已绑定的数据库
  "d1_databases": [{ "binding": "DB","database_id": "43f790e1-dbe6-4877-863d-5f84416f7c9e","database_name": "study-trail" }]
}
